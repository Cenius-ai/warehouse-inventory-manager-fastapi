# Warehouse Inventory Manager — Environment Variables
# All values below are the dev defaults; the app works with NO .env file.

# Session signing key — auto-generated on every boot when unset.
# Set a static value in production to keep sessions across restarts.
# SECRET_KEY=change-me-to-a-random-64-hex-string

# SQLite database path (relative)
DATABASE_URL=sqlite:///./app.db

# Admin account password (dev default: admin123)
# ADMIN_PASSWORD=admin123

# Set to "true" in production (behind TLS) to mark session cookies Secure
# SESSION_HTTPS_ONLY=false
